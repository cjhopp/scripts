[Unit]
Description=Pull Cape/IGU SDS from cluster to QNAP mount
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/qnap_hdd

[Service]
Type=oneshot
User=chopp
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/default/cussp-igu-sds-pull
ExecStart=/usr/bin/env SSH_BATCH_MODE=true /usr/local/sbin/cussp_pull_igu_sds_to_fumarole.sh
StandardOutput=journal
StandardError=journal
