[Unit]
Description=CUSSP Results / ML images Panel app
After=network.target

[Service]
Type=simple
User=chopp
WorkingDirectory=/home/chopp/scripts/python/dash_apps
Environment=PATH=/home/chopp/miniconda3/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/chopp/miniconda3/bin/panel serve \
    /home/chopp/scripts/python/dash_apps/cussp_results.py \
    --port 5007 \
    --prefix /results \
    --allow-websocket-origin www.cussp.lbl.gov \
    --num-procs 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
