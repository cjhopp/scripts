[Unit]
Description=CUSSP SDS sync to QNAP (one-shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/home/gmf/.config/cussp-sds-backup.env
ExecStart=/usr/bin/env bash /home/gmf/scripts/bash/cussp_sync_sds_to_qnap.sh
StandardOutput=journal
StandardError=journal