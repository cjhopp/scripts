[Unit]
Description=CUSSP seismicity catalog push to web VM (one-shot)
After=network.target

[Service]
Type=oneshot
Environment=PATH=/home/gmf/miniconda3/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/gmf/miniconda3/bin/python \
    /home/gmf/scripts/python/mine/cussp_push_catalog.py \
    --fdsn-url http://localhost:8080 \
    --rsync-target chopp@128.3.71.62:/data/chet-cussp/seismicity/catalog.quakeml \
    --station-rsync-target chopp@128.3.71.62:/data/chet-cussp/seismicity/stations_hmc.csv \
    --ssh-key /home/gmf/.ssh/id_ed25519
StandardOutput=journal
StandardError=journal
